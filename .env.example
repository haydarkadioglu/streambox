# Default local mode, no Docker required.
DATABASE_URL=sqlite:///./stream-local.db
REDIS_URL=memory://
CELERY_TASK_ALWAYS_EAGER=true
JWT_SECRET=local-dev-secret-change-before-vps
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin12345
PUBLIC_BASE_URL=http://localhost:8000
CORS_ORIGINS=["http://localhost:5173","http://localhost:8000","http://localhost:8080"]
STORAGE_ROOT=./storage
UPLOAD_MAX_MB=2048

# Docker Compose overrides database, Redis, storage, and public URL internally.
# For VPS production, change JWT_SECRET, ADMIN_EMAIL, ADMIN_PASSWORD,
# PUBLIC_BASE_URL, and CORS_ORIGINS.
